   "source": [
    "import os\n",
    "import shutil\n",
    "masks = os.listdir(\"images/masks\")\n",
    "dji = os.listdir(\"F:/jpg\")\n",
    "for i in masks:\n",
    "    num = i.split(\"_\")[1].split(\".\")[0]\n",
    "    for name in dji:\n",
    "        if num in name:\n",
    "            shutil.copy2(os.path.join(\"F:/jpg\",name), os.path.join(\"images/imgs\",name))"
   ]
  }
 ],
